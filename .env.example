# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Used by OpenRouterBackend (src/agent_game_framework/agents/openrouter.py) when
# no api_key/client is passed to its constructor. Model strings are OpenRouter's
# own "<provider>/<model>" slugs, e.g. "openai/gpt-4o-mini" -- passed separately
# as OpenRouterBackend(model=...), not read from this file.
OPENROUTER_API_KEY=
